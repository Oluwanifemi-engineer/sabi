# Sabi works out of the box in demo mode. Add a key to enable the live AI engine.
# Any OpenAI-compatible provider works (OpenAI, Azure OpenAI, OpenRouter, Groq, Together, local).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: model used for photo intake (must accept image input).
# Falls back to LLM_MODEL if unset. Examples:
#   OpenAI      -> gpt-4o
#   OpenRouter  -> google/gemini-2.0-flash-001
#   Anthropic   -> claude-3-5-sonnet-20241022
LLM_VISION_MODEL=
