# Sabi works out of the box in demo mode. Add a key to enable the live AI engine.
#
# Any OpenAI-compatible provider works (OpenAI, Azure OpenAI, OpenRouter, Groq,
# Together, a local server). This is the configuration verified end-to-end with
# this codebase — Groq's free tier needs no credit card:
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Model used for photo intake (must accept image input).
#
# This is deliberately explicit. A text-only model cannot read a photo, so if
# this is unset, photo intake serves a sample extraction rather than calling a
# model and failing on every request. Examples:
#   Groq        -> qwen/qwen3.8-27b
#   OpenAI      -> gpt-4o
#   OpenRouter  -> google/gemini-2.0-flash-001
LLM_VISION_MODEL=
